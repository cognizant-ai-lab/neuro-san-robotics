[ -n "${VIRTUAL_ENV:-}" ] || source .venv/bin/activate

# Snapshot pristine paths once so re-sourcing is idempotent
if [ -z "${SETMYENV_BASE+x}" ]; then
  export SETMYENV_BASE=1
  export SETMYENV_BASE_PYTHONPATH="${PYTHONPATH:-}"
  export SETMYENV_BASE_LD_LIBRARY_PATH="${LD_LIBRARY_PATH:-}"
fi

# RealSense: locally built, never system-installed
export RS_VER="${RS_VER:-2.55.1}"
RS_PY="$HOME/librealsense-$RS_VER/build/Release"   # pyrealsense2*.so
RS_LIB="$HOME/librealsense-$RS_VER/build"          # librealsense2.so.2.x
ls "$RS_PY"/pyrealsense2*.so >/dev/null 2>&1 \
  || printf 'WARN: no pyrealsense2 .so under %s\n' "$RS_PY" >&2

# Piper voice: the offline TTS fallback. requirements.txt installs the piper
# binary but not the voice it speaks with, and without the voice the robot
# falls past Piper to espeak-ng, which sounds far worse. This is only checked
# here, not downloaded -- it is ~114 MB, and sourcing this file should not
# block on a download. Set GO2_PIPER_AUTO_INSTALL=1 to fetch it automatically
# on first use instead.
PIPER_VOICE="${GO2_PIPER_MODEL:-/home/unitree/piper_models/en_GB-cori-high.onnx}"
if [ ! -f "$PIPER_VOICE" ]; then
  if [ "${GO2_PIPER_AUTO_INSTALL:-0}" = "1" ]; then
    python scripts/install_piper_voice.py
  else
    printf 'WARN: no Piper voice at %s; offline TTS will use espeak-ng.\n' "$PIPER_VOICE" >&2
    printf '      Fix with: python scripts/install_piper_voice.py\n' >&2
  fi
fi

export PYTHONPATH="$RS_PY:$PWD:$PWD/coded_tools:$SETMYENV_BASE_PYTHONPATH"
export LD_LIBRARY_PATH="$PWD/cyclonedds/install/lib:$RS_LIB:$SETMYENV_BASE_LD_LIBRARY_PATH"

export AGENT_TOOL_PATH="$PWD/coded_tools"
export AGENT_MANIFEST_FILE="$PWD/registries/manifest.hocon"
export CYCLONEDDS_HOME="$PWD/cyclonedds/install"
export CYCLONEDDS_URI="file://$PWD/cyclonedds.xml"

# Who this robot is. The name reaches the agent persona, the speech recogniser
# and the web UI; the home lab reaches the persona and the recogniser. Edit
# both per unit, for example:
#   ROBOT_NAME="BIT-2"
#   ROBOT_HOME="the Cognizant AI Lab in Bengaluru"
# ROBOT_HOME is read mid-sentence ("You live in ..."), so keep the leading
# lowercase article. Both are read when the agent starts, so restart the app
# after changing them.
export ROBOT_NAME="CAIL-E"
export ROBOT_HOME="the Cognizant AI Lab (CAIL) in San Francisco"

# Where this robot is. The map belongs to the building, not the robot, so every
# robot in the same lab points at the same file. There is no default in code:
# leave this empty and the robot reports that it has no map and offers only
# move_forward and turn, which is the right answer at a site we have not
# mapped yet. Set it once a map exists for your lab.
#   San Francisco : "$PWD/maps/cail_lab.json"
#   Not yet mapped: ""
export NAV_MAP_FILE="$PWD/maps/cail_lab.json"

# Node in the above map where the robot is parked at startup. Must name a real
# node in NAV_MAP_FILE; the robot warns and starts unanchored if it does not.
export NAV_INITIAL_LOCATION="charging_station"

# Address browsers use to reach the Flask UI, embedded as an IP SAN in the
# TLS cert. DHCP rotates this, so auto-detect from the default route rather
# than hardcoding it; export ROBOT_HOST_IP beforehand to override.
# After an IP rotation, refresh the cert with:
#   python scripts/setup_tls_certs.py
export ROBOT_HOST_IP="${ROBOT_HOST_IP:-$(ip route get 1.1.1.1 2>/dev/null \
  | awk '{for (i=1; i<=NF; i++) if ($i == "src") print $(i+1)}')}"
export TLS_CERT_DIR="${TLS_CERT_DIR:-$HOME/certs}"

printf 'RS_VER=%s\n' "$RS_VER"
printf 'PYTHONPATH=%s\n' "$PYTHONPATH"
printf 'AGENT_TOOL_PATH=%s\n' "$AGENT_TOOL_PATH"
printf 'AGENT_MANIFEST_FILE=%s\n' "$AGENT_MANIFEST_FILE"
printf 'CYCLONEDDS_HOME=%s\n' "$CYCLONEDDS_HOME"
printf 'CYCLONEDDS_URI=%s\n' "$CYCLONEDDS_URI"
printf 'LD_LIBRARY_PATH=%s\n' "$LD_LIBRARY_PATH"
printf 'ROBOT_NAME=%s\n' "$ROBOT_NAME"
printf 'ROBOT_HOME=%s\n' "$ROBOT_HOME"
printf 'NAV_MAP_FILE=%s\n' "${NAV_MAP_FILE:-(none, relative navigation only)}"
printf 'NAV_INITIAL_LOCATION=%s\n' "$NAV_INITIAL_LOCATION"
printf 'ROBOT_HOST_IP=%s\n' "$ROBOT_HOST_IP"
printf 'TLS_CERT_DIR=%s\n' "$TLS_CERT_DIR"

# =====================================================================
# Model providers
# =====================================================================
# TWO SEPARATE APIs are in play here, and they are configured independently:
#
#   1. AGENTS -- the reasoning LLM behind every agent network. neuro-san owns
#      this. It reads the AZURE_OPENAI_* variables itself and takes the model
#      from registries/llm_config.hocon, which in turn reads the AGENT_LLM_*
#      variables below.
#
#   2. AUDIO -- text-to-speech, push-to-talk Whisper, and ambient realtime
#      transcription. neuro-san has no audio support at all, so this repo calls
#      those endpoints directly and they need their own settings. These are the
#      GO2_* variables below.
#
# The two are deliberately separable. Azure's audio models are region-limited,
# so a customer whose chat deployment lives in one resource often cannot host
# gpt-4o-mini-tts or whisper alongside it. Any combination works: both on
# Azure, both on public OpenAI, or agents on Azure with audio on OpenAI.
#
# Changing model later is only ever an edit to this file plus a restart. No
# HOCON file needs to be touched.
# ---------------------------------------------------------------------

# --- Option A: public OpenAI (default) -------------------------------
# Leave the Azure block commented out and set just this. Prefer exporting it
# outside this script, or keep it in an untracked local file.
# export OPENAI_API_KEY="sk-..."

# --- Option B: Azure OpenAI ------------------------------------------
# Uncomment this block and fill in the values your Azure dev-ops team gives
# you. The deployment names rarely match the model names -- ask for them
# explicitly rather than guessing.
#
# WHERE THESE VALUES COME FROM
#
#   Deployment names are chosen by whoever deployed the model, so there is no
#   canonical name for "gpt-5.6" -- you have to look up what yours was called.
#   In the portal: Azure AI Foundry -> your resource -> Deployments. The Name
#   column is the deployment name; the Model column says what it serves.
#   From the CLI, which also shows which model each deployment is running:
#
#     az cognitiveservices account list \
#       --query "[?kind=='OpenAI'].{name:name,rg:resourceGroup,loc:location}" -o table
#
#     az cognitiveservices account deployment list --name <resource> --resource-group <rg> \
#       --query "[].{deployment:name, model:properties.model.name, version:properties.model.version}" \
#       -o table
#
#   WHAT TO ASK THEM TO DEPLOY
#
#   Five models are in play. Azure offers all five under the same names this
#   repo already uses on public OpenAI, so nothing needs substituting:
#
#     purpose              model to deploy      version      -> variable
#     -------------------  -------------------  -----------  ------------------------------
#     conscious assistant  gpt-5.1              latest       AZURE_OPENAI_DEPLOYMENT_NAME
#     unigo2 "look alive"  gpt-4o               2024-08-06   AZURE_OPENAI_DEPLOYMENT_NAME_LIGHT
#     text to speech       gpt-4o-mini-tts      latest       GO2_AZURE_TTS_DEPLOYMENT
#     push-to-talk STT     whisper              latest       GO2_AZURE_TRANSCRIBE_DEPLOYMENT
#     ambient STT          gpt-4o-transcribe    latest       GO2_AZURE_REALTIME_DEPLOYMENT
#
#   Match the Model column of the deployment list above to the first column
#   here, then put that deployment's Name into the variable on the right.
#
#   The gpt-4o version matters: Azure lets you pick it at deploy time, and
#   2024-08-06 is the snapshot this repo has always used for that network.
#
#   Two things to watch:
#
#   The audio models are far more region-limited than the chat models, and
#   which ones a resource can deploy varies. Check before promising anything:
#
#     az cognitiveservices account list-models --name <resource> --resource-group <rg> \
#       --query "[?contains(name,'tts') || contains(name,'whisper') || contains(name,'transcribe')].{model:name, version:version}" \
#       -o table
#
#   Whisper on Azure OpenAI is preview and deploys only in North Central US
#   and West Europe. If the resource is elsewhere, either deploy whisper into
#   a second resource in one of those regions, or set GO2_AUDIO_PROVIDER=
#   "openai" to keep speech on public OpenAI. Azure AI Speech also hosts
#   Whisper in more regions, but that is a different service with different
#   routes and this repo does not call it.
#
#   IF THE REGION HAS NO AUDIO MODELS AT ALL
#
#   Speech out still works; speech in does not. The two degrade very
#   differently, and it is worth knowing which before promising a deployment.
#
#   Text to speech degrades cleanly. Set:
#       export GO2_TTS_ENGINE="piper"
#   and the robot speaks with the offline neural voice, never calling out at
#   all. Do set this explicitly: on the default "auto" the robot still tries
#   the hosted call first and waits out GO2_OPENAI_TIMEOUT_SECONDS before
#   falling back, which puts that delay in front of every single utterance.
#   Piper needs its voice model -- see the warning this script prints at
#   startup, or run scripts/install_piper_voice.py.
#
#   Speech to text does not degrade. There is no offline recogniser in this
#   repo, so with no whisper and no gpt-4o-transcribe reachable, both the
#   push-to-talk button and ambient listening stop working entirely. The
#   options are: deploy those two models into a second resource in a region
#   that has them, set GO2_AUDIO_PROVIDER="openai" to use public OpenAI for
#   speech, or run the robot without voice input and drive it by text.
#
#   Older "tts" / "tts-hd" deployments are not worth chasing as a middle
#   ground: both are still Preview on Azure while gpt-4o-mini-tts is GA, and
#   Piper runs locally with no latency or egress. If you do use one, blank
#   GO2_OPENAI_INSTRUCTIONS (they reject style guidance) and pick a classic
#   voice such as alloy or nova, since "coral" is not one of theirs.
#
#   Do not reach for a newer assistant model than the gpt-5.5 generation.
#   GPT-5.6 (sol / terra / luna) and GPT-6 Astra serve tool calling only over
#   the Responses API, which the bundled neuro-san does not speak -- and every
#   agent here calls tools on every turn, so those deployments fail outright.
#   It is not a version to chase: neuro-san added Responses support in 0.7,
#   which needs Python 3.12, and this robot is held at 3.11 by the CycloneDDS
#   build the Unitree SDK rides on. gpt-5.1 through gpt-5.5 are all fine.
#
#   Endpoint and key come from the same resource:
#     az cognitiveservices account show --name <resource> --resource-group <rg> \
#       --query properties.endpoint -o tsv
#     az cognitiveservices account keys list --name <resource> --resource-group <rg> \
#       --query key1 -o tsv
#
#   OPENAI_API_VERSION is NOT discoverable from Azure. It is a constant you
#   pick from Microsoft's published API version list, and the Python SDK
#   refuses to build a client without it. "2024-10-21" is a safe GA value;
#   use "preview" only if you need a feature that has not reached GA.
#   If an audio model 404s on a deployment you can see in the portal, a too-old
#   api-version is the usual cause -- those models landed after the older ones.
#
# 1. Credentials. Shared by the agents and, by default, by audio too.
# export AZURE_OPENAI_ENDPOINT="https://<your-resource>.openai.azure.com"
# export AZURE_OPENAI_API_KEY="..."
# export OPENAI_API_VERSION="2024-10-21"
#
#    Entra ID instead of a resource key? Set this and leave the key unset.
# export AZURE_OPENAI_AD_TOKEN="..."
#
# 2. AGENTS. Setting the class switches every agent network to Azure at once.
# export AGENT_LLM_CLASS="azure-openai"
# export AZURE_OPENAI_DEPLOYMENT_NAME="<your-chat-deployment>"
#
#    Optional. Azure routes on the deployment name above; this is carried for
#    logs and token accounting. Set it to whatever model the deployment serves
#    -- any name works, including one neuro-san has never heard of.
# export AGENT_LLM_MODEL_NAME="gpt-5.1"
#
#    Optional. The unigo2 "look alive" network runs on a cheaper model. Leave
#    these unset to run it on the same deployment as the assistant.
# export AZURE_OPENAI_DEPLOYMENT_NAME_LIGHT="<your-cheap-deployment>"
# export AGENT_LLM_MODEL_NAME_LIGHT="gpt-4o-mini"
#
# 3. AUDIO. "auto" follows AZURE_OPENAI_ENDPOINT; set "openai" to keep speech
#    on public OpenAI while the agents run on Azure; set "azure" to force it.
# export GO2_AUDIO_PROVIDER="auto"
# export GO2_AZURE_TTS_DEPLOYMENT="<your-gpt-4o-mini-tts-deployment>"
# export GO2_AZURE_TRANSCRIBE_DEPLOYMENT="<your-whisper-deployment>"
# export GO2_AZURE_REALTIME_DEPLOYMENT="<your-realtime-transcribe-deployment>"

# --- Audio model choices (either provider) ---------------------------
# On Azure these name the model a deployment serves; the deployment variables
# above are what actually route the request.
# export GO2_OPENAI_MODEL="gpt-4o-mini-tts"
# export GO2_OPENAI_VOICE="coral"
# export CONSCIOUS_AMBIENT_TRANSCRIPTION_MODEL="gpt-4o-transcribe"

# One Azure deployment serves both agent networks unless a cheaper one is
# named. Done here rather than in HOCON, where an unset default leaves a null.
if [ -n "${AZURE_OPENAI_DEPLOYMENT_NAME:-}" ]; then
  export AZURE_OPENAI_DEPLOYMENT_NAME_LIGHT="${AZURE_OPENAI_DEPLOYMENT_NAME_LIGHT:-$AZURE_OPENAI_DEPLOYMENT_NAME}"
fi

printf 'AGENT_LLM_CLASS=%s\n' "${AGENT_LLM_CLASS:-openai (default)}"
printf 'AZURE_OPENAI_ENDPOINT=%s\n' "${AZURE_OPENAI_ENDPOINT:-(unset, using public OpenAI)}"
printf 'AZURE_OPENAI_DEPLOYMENT_NAME=%s\n' "${AZURE_OPENAI_DEPLOYMENT_NAME:-(unset)}"
printf 'GO2_AUDIO_PROVIDER=%s\n' "${GO2_AUDIO_PROVIDER:-auto}"

