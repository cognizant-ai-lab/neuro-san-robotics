# Copy this to setmyenv.sh, add your API key, then: source setmyenv.sh
#
# Full explanations for every variable in this file:
#   docs/env_variables_guide.md

[ -n "${VIRTUAL_ENV:-}" ] || source .venv/bin/activate

# Snapshot pristine paths once so re-sourcing is idempotent
if [ -z "${SETMYENV_BASE+x}" ]; then
  export SETMYENV_BASE=1
  export SETMYENV_BASE_PYTHONPATH="${PYTHONPATH:-}"
  export SETMYENV_BASE_LD_LIBRARY_PATH="${LD_LIBRARY_PATH:-}"
fi

# RealSense: locally built, never system-installed. See docs/env_variables_guide.md#robot-platform
export RS_VER="${RS_VER:-2.55.1}"
RS_PY="$HOME/librealsense-$RS_VER/build/Release"
RS_LIB="$HOME/librealsense-$RS_VER/build"
ls "$RS_PY"/pyrealsense2*.so >/dev/null 2>&1 \
  || printf 'WARN: no pyrealsense2 .so under %s\n' "$RS_PY" >&2

export PYTHONPATH="$RS_PY:$PWD:$PWD/coded_tools:$SETMYENV_BASE_PYTHONPATH"
export LD_LIBRARY_PATH="$PWD/cyclonedds/install/lib:$RS_LIB:$SETMYENV_BASE_LD_LIBRARY_PATH"

export AGENT_TOOL_PATH="$PWD/coded_tools"
export AGENT_MANIFEST_FILE="$PWD/registries/manifest.hocon"
export CYCLONEDDS_HOME="$PWD/cyclonedds/install"
export CYCLONEDDS_URI="file://$PWD/cyclonedds.xml"

# Who this robot is. Edit both per unit. See docs/env_variables_guide.md#robot-identity
export ROBOT_NAME="CAIL-E"
export ROBOT_HOME="the Cognizant AI Lab (CAIL) in San Francisco"

# Where this robot is. Empty means no map. See docs/env_variables_guide.md#navigation
export NAV_MAP_FILE="$PWD/maps/cail_lab.json"
export NAV_INITIAL_LOCATION="charging_station"

# Address browsers reach the UI on, baked into the TLS cert. See docs/env_variables_guide.md#web-ui-and-tls
export ROBOT_HOST_IP="${ROBOT_HOST_IP:-$(ip route get 1.1.1.1 2>/dev/null \
  | awk '{for (i=1; i<=NF; i++) if ($i == "src") print $(i+1)}')}"
export TLS_CERT_DIR="${TLS_CERT_DIR:-$HOME/certs}"

printf '\n===================== robot environment =====================\n'
printf 'RS_VER=%s\n' "$RS_VER"
printf 'PYTHONPATH=%s\n' "$PYTHONPATH"
printf 'AGENT_TOOL_PATH=%s\n' "$AGENT_TOOL_PATH"
printf 'AGENT_MANIFEST_FILE=%s\n' "$AGENT_MANIFEST_FILE"
printf 'CYCLONEDDS_HOME=%s\n' "$CYCLONEDDS_HOME"
printf 'CYCLONEDDS_URI=%s\n' "$CYCLONEDDS_URI"
printf 'LD_LIBRARY_PATH=%s\n' "$LD_LIBRARY_PATH"
printf 'ROBOT_NAME=%s\n' "$ROBOT_NAME"
printf 'ROBOT_HOME=%s\n' "$ROBOT_HOME"
printf 'NAV_MAP_FILE=%s\n' "${NAV_MAP_FILE:-(none, relative navigation only)}"
printf 'NAV_INITIAL_LOCATION=%s\n' "$NAV_INITIAL_LOCATION"
printf 'ROBOT_HOST_IP=%s\n' "$ROBOT_HOST_IP"
printf 'TLS_CERT_DIR=%s\n' "$TLS_CERT_DIR"

# Keep this outside the tracked file, or in an untracked local one.
# See docs/env_variables_guide.md#public-openai-default
# export OPENAI_API_KEY="..."


# =====================================================================
# New in this version. Existing robots need change nothing below here:
# every default matches how the robot already behaves.
# =====================================================================

# ---------------------------------------------------------------------
# 1. AGENTS -- which LLM the agent networks think with.
#    Leave commented for public OpenAI (set OPENAI_API_KEY above).
#    Recipes for common setups:
#    docs/env_variables_guide.md#choosing-a-setup
# ---------------------------------------------------------------------
# export AGENT_LLM_CLASS="azure-openai"
# export AZURE_OPENAI_ENDPOINT="https://<your-resource>.openai.azure.com"
# export AZURE_OPENAI_API_KEY="..."
# export OPENAI_API_VERSION="2024-10-21"
# export AZURE_OPENAI_DEPLOYMENT_NAME="<your-chat-deployment>"

# OPTIONAL, logs only. Azure routes on the deployment name above; these are
# carried for log lines and token accounting and change no behaviour.
# export AGENT_LLM_MODEL_NAME="gpt-5.1"
# export AGENT_LLM_MODEL_NAME_LIGHT="gpt-4o-mini"

# OPTIONAL. The unigo2 network runs on a cheaper model. Unset means it shares
# the deployment above.
# export AZURE_OPENAI_DEPLOYMENT_NAME_LIGHT="<your-cheaper-deployment>"

# ---------------------------------------------------------------------
# 2. SPEECH OUT and 3. SPEECH IN -- independent of the agents, and of each
#    other. Either can be a hosted model or one running on the robot.
#      auto   hosted first, falling back to the robot   (default)
#      piper  speak on the robot, never call out
#      local  listen on the robot, never call out
#    Naming piper or local here also installs what they need when this file
#    is sourced. See docs/env_variables_guide.md#choosing-a-setup
# ---------------------------------------------------------------------
export GO2_TTS_ENGINE="auto"
export GO2_STT_ENGINE="auto"

# Which cloud hosted speech calls. Consulted ONLY while the two settings above
# are still reaching a hosted model; ignored once both are piper/local.
# "auto" follows AZURE_OPENAI_ENDPOINT. Set "openai" to keep speech on public
# OpenAI while the agents run on Azure.
# export GO2_AUDIO_PROVIDER="auto"

# Azure speech deployments. Only if GO2_AUDIO_PROVIDER resolves to azure.
# Azure's speech models are region-limited and are often absent from the
# resource serving chat; if so, use piper/local above instead.
# export GO2_AZURE_TTS_DEPLOYMENT="<your-gpt-4o-mini-tts-deployment>"
# export GO2_AZURE_TRANSCRIBE_DEPLOYMENT="<your-whisper-deployment>"
# export GO2_AZURE_REALTIME_DEPLOYMENT="<your-realtime-transcribe-deployment>"

# OPTIONAL. Hosted speech models and voice. Ignored once speech is local.
# export GO2_OPENAI_MODEL="gpt-4o-mini-tts"
# export GO2_OPENAI_VOICE="coral"
# export CONSCIOUS_AMBIENT_TRANSCRIPTION_MODEL="gpt-4o-transcribe"

# OPTIONAL. The robot's own recogniser. Ignored unless GO2_STT_ENGINE reaches
# it. See docs/env_variables_guide.md#the-local-recogniser
# export GO2_STT_MODEL="base"
# export GO2_STT_DEVICE="auto"

# One Azure deployment serves both agent networks unless a cheaper one is named.
if [ -n "${AZURE_OPENAI_DEPLOYMENT_NAME:-}" ]; then
  export AZURE_OPENAI_DEPLOYMENT_NAME_LIGHT="${AZURE_OPENAI_DEPLOYMENT_NAME_LIGHT:-$AZURE_OPENAI_DEPLOYMENT_NAME}"
fi

# Offline models. Must stay below the engine settings above, which they read.
# See docs/env_variables_guide.md#piper-the-offline-voice
PIPER_VOICE="${GO2_PIPER_MODEL:-$HOME/piper_models/en_GB-cori-high.onnx}"
case "$GO2_TTS_ENGINE" in
  *piper*) PIPER_REQUIRED=1 ;;
  *)       PIPER_REQUIRED=0 ;;
esac
if [ ! -f "$PIPER_VOICE" ]; then
  if [ "$PIPER_REQUIRED" = "1" ] || [ "${GO2_PIPER_AUTO_INSTALL:-0}" = "1" ]; then
    printf 'Installing Piper voice (GO2_TTS_ENGINE names piper)...\n' >&2
    python scripts/install_piper_voice.py \
      || printf 'WARN: Piper voice install failed; offline TTS will use espeak-ng.\n' >&2
  else
    printf 'WARN: no Piper voice; offline TTS would use espeak-ng. Fix with:\n' >&2
    printf '      python scripts/install_piper_voice.py\n' >&2
  fi
fi

if [ "$GO2_STT_ENGINE" = "local" ]; then
  python scripts/install_stt_model.py \
    || printf 'WARN: local speech model unavailable; voice input will not work.\n' >&2
fi

printf '\n======================= models & speech ======================\n'
if [ "${AGENT_LLM_CLASS:-openai}" = "azure-openai" ] || [ -n "${AZURE_OPENAI_ENDPOINT:-}" ]; then
  printf 'AGENT_LLM_CLASS=%s\n' "${AGENT_LLM_CLASS:-openai}"
  printf 'AGENT_LLM_MODEL_NAME=%s\n' "${AGENT_LLM_MODEL_NAME:-(default in the agent registry)}"
  printf 'AZURE_OPENAI_ENDPOINT=%s\n' "${AZURE_OPENAI_ENDPOINT:-(unset)}"
  printf 'AZURE_OPENAI_DEPLOYMENT_NAME=%s\n' "${AZURE_OPENAI_DEPLOYMENT_NAME:-(unset)}"
  printf 'AZURE_OPENAI_DEPLOYMENT_NAME_LIGHT=%s\n' "${AZURE_OPENAI_DEPLOYMENT_NAME_LIGHT:-(unset)}"
  printf 'OPENAI_API_VERSION=%s\n' "${OPENAI_API_VERSION:-(unset -- required for Azure)}"
else
  printf 'LLM_PROVIDER=%s\n' 'public OpenAI'
fi

printf 'GO2_TTS_ENGINE=%s\n' "$GO2_TTS_ENGINE"
printf 'GO2_STT_ENGINE=%s\n' "$GO2_STT_ENGINE"

# GO2_AUDIO_PROVIDER only decides which cloud hosted speech calls, so it is
# reported only while one of the engines above can still reach a hosted model.
# With both set to speak and listen on the robot it decides nothing.
HOSTED_SPEECH=0
case "$GO2_TTS_ENGINE" in auto|openai) HOSTED_SPEECH=1 ;; esac
case "$GO2_STT_ENGINE" in auto|openai) HOSTED_SPEECH=1 ;; esac
if [ "$HOSTED_SPEECH" = "1" ]; then
  printf 'GO2_AUDIO_PROVIDER=%s\n' "${GO2_AUDIO_PROVIDER:-auto}"
fi

if [ -f "$PIPER_VOICE" ]; then
  printf 'OFFLINE_TTS=%s\n' 'piper'
else
  printf 'OFFLINE_TTS=%s\n' 'espeak-ng (no Piper voice)'
fi
if [ "$GO2_STT_ENGINE" = "local" ]; then
  printf 'OFFLINE_STT=%s\n' "whisper-${GO2_STT_MODEL:-base} on ${GO2_STT_DEVICE:-cpu}"
fi
printf '=============================================================\n\n'
