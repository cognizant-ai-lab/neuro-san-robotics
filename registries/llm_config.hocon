# Shared LLM wiring for every agent network in registries/.
#
# This is NOT an agent network. It only defines values the network files
# substitute in, so a site can retarget every agent at its own models without
# editing an agent network. Everything here is driven by environment variables
# set in setmyenv.sh, so moving a robot from public OpenAI to a customer's
# Azure deployment -- or from one Azure deployment to a newer one -- is an edit
# to that one shell file and a restart.
#
# HOCON note: an unset ${?VAR} leaves the key absent rather than null, and a
# later assignment to the same key wins. That is what lets a default sit above
# an override on the next line. Env substitution is NOT allowed in an `include`
# line, which is why provider selection is a value here and not a second file.

{
    # AGENT_LLM_CLASS picks which LangChain chat class neuro-san builds:
    #   "openai"        public OpenAI, keyed by OPENAI_API_KEY          (default)
    #   "azure-openai"  a customer's Azure OpenAI resource
    # Other values neuro-san accepts: anthropic, gemini, bedrock, ollama, nvidia.
    #
    # The default/override pair is repeated in each block below rather than
    # hoisted into one shared key. pyhocon cannot resolve a ${reference} to a key
    # whose only assignment was an unset ${?VAR}, so the indirection breaks the
    # moment a site leaves AGENT_LLM_CLASS unset -- which is the default case.
    #
    # Naming an explicit class makes neuro-san skip its built-in model catalogue
    # and hand these values straight to the provider. That is deliberate: it means
    # a model neuro-san has never heard of -- a gpt-5.6, or whatever a customer
    # deploys next year -- works without waiting for a neuro-san release.
    #
    # On Azure the deployment_name is what routes the request; model_name is
    # carried for logging and token accounting and need not match a public
    # OpenAI model. Ask the customer's dev-ops team what they named the
    # deployment, as it rarely matches the model name.

    # The conscious assistant: the robot's main reasoning agent.
    llm_config_default {
        class = "openai"
        class = ${?AGENT_LLM_CLASS}

        model_name = "gpt-5.1"
        model_name = ${?AGENT_LLM_MODEL_NAME}

        # Azure only. Ignored by the "openai" class, so it is safe to leave set.
        deployment_name = ${?AZURE_OPENAI_DEPLOYMENT_NAME}
        openai_api_version = ${?OPENAI_API_VERSION}
    }

    # The unigo2 "look alive" network. Deliberately a cheaper model than the
    # assistant above: it only turns short commands into robot actions.
    llm_config_lightweight {
        class = "openai"
        class = ${?AGENT_LLM_CLASS}

        # Spelled out with its date because naming an explicit class above skips
        # neuro-san's catalogue, and the catalogue is what used to expand a bare
        # "gpt-4o" to this pin. Keeping it verbatim means this network talks to
        # the same snapshot it always has.
        model_name = "gpt-4o-2024-08-06"
        model_name = ${?AGENT_LLM_MODEL_NAME_LIGHT}

        # A site with one Azure deployment does not set this; setmyenv.sh
        # defaults it to AZURE_OPENAI_DEPLOYMENT_NAME. The fallback lives in the
        # shell because two ${?VAR} lines on one key leave a null behind here
        # when neither is set, rather than omitting the key.
        deployment_name = ${?AZURE_OPENAI_DEPLOYMENT_NAME_LIGHT}
        openai_api_version = ${?OPENAI_API_VERSION}
    }
}
