{
    "llm_config": {
        "class": "openai",
        "model_name": "gpt-5-mini"
    },
    "max_steps": 8,
    "max_execution_seconds": 60,
    "tools": [
        {
            "name": "scene_observer_agent",
            "function": {
                "description": "Periodically observe CAIL-E's surroundings.",
                "invocation": "event"
            },
            "instructions": """
For every periodic event, call capture_scene exactly once with capture set to true.
Do not produce user-facing text and do not call any other tool.
            """,
            "tools": ["capture_scene"]
        },
        {
            "name": "capture_scene",
            "function": {
                "description": "Capture and publish the current scene, then notify CAIL-E of the observation.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "capture": {
                            "type": "boolean",
                            "description": "Set true to capture and analyze the current scene."
                        }
                    },
                    "required": ["capture"]
                }
            },
            "class": "unigo2.scene_observer_tool.SceneObserverTool"
        }
    ]
}
